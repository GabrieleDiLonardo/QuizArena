[
 {quizarena, [
   %% Nodi del cluster, in ordine: il primo e' il seed di Mnesia e l'ordine
   %% definisce gli identificatori dell'elezione Bully. In deploy viene
   %% sovrascritto dalla variabile d'ambiente QUIZARENA_CLUSTER_NODES.
   {cluster_nodes, []},
   {host_grace_ms, 30000}
 ]},
 {kernel, [
   %% Un nodo irraggiungibile viene dichiarato down dopo circa 8-10 s
   %% (default 60 s): e' il timeout del rilevatore di guasti.
   {net_ticktime, 8},
   {prevent_overlapping_partitions, true}
 ]},
 {mnesia, [
   {dir, "data/mnesia"}
 ]}
].
